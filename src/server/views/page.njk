<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Server-Driven React Flow</title>
  <style>
    body { margin: 0; font: 14px/1.4 system-ui, sans-serif; color: #111; }
    header { padding: 12px 16px; border-bottom: 1px solid #e5e7eb;
             display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    header h1 { font-size: 16px; margin: 0; }
    header p { margin: 4px 0 0; color: #6b7280; }
    .toolbar { display: flex; align-items: center; gap: 12px; }
    .toolbar button { font: inherit; padding: 6px 14px; border: 1px solid #2563eb;
             background: #2563eb; color: #fff; border-radius: 6px; cursor: pointer; }
    .toolbar .hint { font-size: 12px; color: #9ca3af; }
    /* Add-node popover, tethered to its trigger with CSS anchor positioning. */
    .add-trigger { anchor-name: --add-trigger; }
    .add-popover { position-anchor: --add-trigger; position-area: bottom span-right;
            position-try-fallbacks: flip-block, flip-inline; inset: auto; margin: 6px 0 0;
            border: 1px solid #e5e7eb; border-radius: 10px; padding: 8px; min-width: 180px;
            list-style: none; box-shadow: 0 10px 30px rgba(0,0,0,.15); }
    /* Only set display when open, so the UA `[popover]:not(:popover-open){display:none}`
       still hides it when closed (author styles otherwise override the UA rule). */
    .add-popover:popover-open { display: flex; flex-direction: column; gap: 6px; }
    .add-popover li { display: contents; }
    main { display: grid; grid-template-columns: 1fr 280px; gap: 0; height: calc(100vh - 64px); }
    react-flow { display: block; width: 100%; height: 100%; }
    /* <flow-node> is projected into React Flow via a slot; metadata elements stay hidden. */
    flow-node { display: block; }
    flow-action, flow-edge { display: none; }
    #inspector { border-left: 1px solid #e5e7eb; padding: 16px; overflow: auto; }
    .inspector-placeholder { color: #9ca3af; }
    .inspector-form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
    .inspector-form label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: #6b7280; }
    .inspector-form input, .inspector-form select { font: inherit; padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; }
    .inspector-form button { align-self: flex-start; font: inherit; padding: 6px 14px; border: 1px solid #2563eb;
            background: #2563eb; color: #fff; border-radius: 6px; cursor: pointer; }
    .inspector-meta dt { font-size: 11px; text-transform: uppercase; color: #9ca3af; margin-top: 8px; }
    .inspector-meta dd { margin: 2px 0 0; }

    /* Node bodies live in light DOM (projected through a slot), so document CSS styles them. */
    .card { width: 180px; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px;
            background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.06); cursor: pointer; }
    .card--approved { border-color: #16a34a; }
    .card--pending { border-color: #d97706; }
    .card--ready { border-color: #2563eb; }
    .card--draft { border-color: #9ca3af; }
    .card--new { border-color: #7c3aed; }
    .card__head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .card__kind { font-size: 11px; text-transform: uppercase; letter-spacing: .03em; color: #9ca3af; margin: 2px 0 6px; }
    .card__field { color: #4b5563; font-size: 13px; }
    .card__field + .card__actions { margin-top: 8px; }
    .card__label { color: #9ca3af; }
    .card__actions { display: flex; gap: 6px; margin-top: 8px; }
    .card__actions button { font: inherit; padding: 2px 8px; border: 1px solid #d1d5db;
            border-radius: 6px; background: #f9fafb; cursor: pointer; }
    .badge { font-size: 11px; text-transform: uppercase; letter-spacing: .03em;
            padding: 1px 6px; border-radius: 999px; background: #f3f4f6; color: #374151; }
    .card--approved .badge { background: #dcfce7; color: #166534; }
    .card--pending .badge { background: #fef3c7; color: #92400e; }
    .card--ready .badge { background: #dbeafe; color: #1e40af; }
    .card--draft .badge { background: #f3f4f6; color: #4b5563; }
    .card--new .badge { background: #ede9fe; color: #5b21b6; }
  </style>
  <!-- htmx v4 (built-in morph support) -->
  <script src="/vendor/htmx.min.js"></script>
  <!-- the React Flow web component bundle -->
  <script type="module" src="/flow-component.js"></script>
</head>
<body>
  <header>
    <div>
      <h1>Server-Driven React Flow</h1>
      <p>React Flow in a web component. Server owns state; htmx + idiomorph morph the graph.</p>
    </div>
    <div class="toolbar">
      {# Invoker Commands API toggles a popover (light-dismiss: click-away / Esc
         close it for free, so no Cancel button). CSS anchor positioning tethers it
         to the trigger. Each type button also fires its htmx create on the same
         click — hiding the popover only removes it from the top layer, so the
         button stays in the DOM and the request proceeds. Generated from the registry. #}
      <button type="button" class="add-trigger" command="toggle-popover" commandfor="add-popover">+ Add node</button>
      <menu id="add-popover" popover class="add-popover">
        {% for key, t in nodeKinds %}
        <li><button type="button" command="hide-popover" commandfor="add-popover"
          hx-post="/nodes/create" hx-vals='{"kind":"{{ key }}"}'
          hx-target="#graph" hx-swap="innerMorph">{{ t.label }}</button></li>
        {% endfor %}
      </menu>
      <span class="hint">Drag on the canvas to multi-select · ⌫ deletes selection</span>
    </div>
  </header>
  <main>
    {# hx-include carries the open inspector's node id (a hidden input it renders)
       into every flow request, so the server can OOB-refresh the panel when relevant.
       Targets the specific id, not #inspector, to avoid sweeping in the form fields. #}
    <react-flow id="graph" hx-include="#inspector-open">
      {% include "_graph.njk" %}
    </react-flow>
    {# Seed the hx-include marker (empty) so #inspector-open ALWAYS exists — an
       hx-include selector that matches nothing makes htmx log an error. Opening a
       panel replaces this whole subtree with one carrying the node id. #}
    <aside id="inspector">
      <input id="inspector-open" type="hidden" name="inspectorNode" value="" />
      <p class="inspector-placeholder">Click a node to inspect</p>
    </aside>
  </main>
</body>
</html>
