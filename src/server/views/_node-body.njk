{# Server-rendered node body, projected into React Flow via the named slot.
   The whole card is the inspector trigger — handled by htmx in LIGHT DOM, because
   React Flow's onNodeClick (a React synthetic event) can't see clicks on slotted
   content across the shadow boundary. htmx controls here run in light DOM. #}
<div class="card card--{{ n.data.status }}"
  hx-get="/nodes/{{ n.id }}/panel" hx-target="#inspector" hx-swap="innerHTML">
  <div class="card__head">
    <strong>{{ n.data.title }}</strong>
    <span class="badge">{{ n.data.status }}</span>
  </div>
  <div class="card__kind">{{ nodeKinds[n.kind].label }}</div>
  {# Read-only display of this kind's fields (src/server/node-kinds.js). #}
  {% for f in nodeKinds[n.kind].fields %}
  <div class="card__field"><span class="card__label">{{ f.label }}:</span> {{ n.data[f.name] }}</div>
  {% endfor %}
  {% if n.data.status == 'pending' %}
  <div class="card__actions">
    {# `consume` stops this click from also bubbling to the card's inspector trigger. #}
    <button type="button" hx-trigger="click consume"
      hx-post="/orders/{{ n.id }}/approve" hx-target="#graph" hx-swap="innerMorph">
      Approve
    </button>
  </div>
  {% endif %}
</div>
