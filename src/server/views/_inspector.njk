{# Inspector panel content. Swapped into #inspector by the Inspect button, and
   re-rendered out-of-band after an edit so it always reflects server truth.
   The edit form is plain htmx in light DOM: it posts the field, the server
   mutates the store, and the WHOLE graph morphs so the node card updates live. #}
<h2 style="margin-top:0">{{ node.data.title }}</h2>

{# Marks which node's inspector is open. <react-flow hx-include="#inspector-open">
   pulls this into every flow request, so the move route knows whether to OOB-update
   the Position below. Present only while a panel is open; no server state needed. #}
<input id="inspector-open" type="hidden" name="inspectorNode" value="{{ node.id }}" />

<form class="inspector-form"
  hx-post="/nodes/{{ node.id }}/data" hx-target="#graph" hx-swap="innerMorph">
  <label>Title
    <input name="title" value="{{ node.data.title }}" autocomplete="off" />
  </label>
  {# Inputs are driven by the node's kind (src/server/node-kinds.js). #}
  {% for f in nodeKinds[node.kind].fields %}
  <label>{{ f.label }}
    <input name="{{ f.name }}" type="{{ f.type }}" value="{{ node.data[f.name] }}" autocomplete="off" />
  </label>
  {% endfor %}
  <label>Status
    <select name="status">
      {% for s in statuses %}
      <option value="{{ s }}"{% if s == node.data.status %} selected{% endif %}>{{ s }}</option>
      {% endfor %}
    </select>
  </label>
  <button type="submit">Save</button>
</form>

<dl class="inspector-meta">
  <dt>ID</dt><dd>{{ node.id }}</dd>
  {# Node-keyed span so a move can OOB-update just this when the panel is open. #}
  <dt>Position</dt><dd><span id="inspector-position-{{ node.id }}">{{ node.x }}, {{ node.y }}</span></dd>
</dl>
