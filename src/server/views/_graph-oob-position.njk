{# Move response: the whole graph (morphed into #graph) plus a partial that updates
   the moved node's Position span. If the inspector isn't open for this node the
   target won't exist and htmx silently skips the partial. #}
{% include "_graph.njk" %}
<hx-partial hx-target="#inspector-position-{{ node.id }}" hx-swap="innerHTML">{{ node.x }}, {{ node.y }}</hx-partial>
